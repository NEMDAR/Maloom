# Server-only. Never expose to the browser (do NOT prefix with VITE_).
OPENAI_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
# Abuse limits (per client IP, in-memory, per instance)
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_TEXT=40
RATE_LIMIT_AUDIO=15
# Set to 1 ONLY when the app is reachable exclusively via a reverse proxy (Coolify/Traefik)
# that overwrites X-Forwarded-For / X-Real-IP. Otherwise IPs can be spoofed.
TRUST_PROXY=1
